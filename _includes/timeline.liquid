<div class="timeline">
  <div class="timeline-legend">
    <span class="timeline-legend-item">
      <span class="timeline-dot timeline-dot-work" aria-hidden="true"></span>
      Work
    </span>
    <span class="timeline-legend-item">
      <span class="timeline-dot timeline-dot-education" aria-hidden="true"></span>
      Education
    </span>
    <span class="timeline-legend-item">
      <span class="timeline-dot timeline-dot-volunteering" aria-hidden="true"></span>
      Volunteering
    </span>
  </div>

  <ul class="timeline-entries">
    {% assign entries = site.data.timeline | sort: 'start_date' | reverse %}
    {% assign previous_year = '' %}
    {% for item in entries %}
      {% assign entry_year = item.start_date | slice: 0, 4 %}
      {% if entry_year != previous_year %}
        <li class="timeline-year">
          <span>{{ entry_year }}</span>
        </li>
        {% assign previous_year = entry_year %}
      {% endif %}
      <li class="timeline-entry">
        <span class="timeline-marker timeline-dot-{{ item.category }}" aria-hidden="true"></span>
        <span class="timeline-entry-date">{{ item.start_date | append: '-01' | date: '%b %Y' }}</span>
        <div class="timeline-card timeline-card-{{ item.category }}">
          <div class="timeline-header">
            <span class="timeline-date">
              {{ item.start_date | append: '-01' | date: '%b %Y' }}
              {%- if item.end_date == 'present' %}
                – Present
              {%- elsif item.end_date %}
                – {{ item.end_date | append: '-01' | date: '%b %Y' }}
              {%- endif %}
            </span>
            <span class="timeline-entry-location timeline-location-{{ item.category }}">
              <i class="fa-solid fa-location-dot iconlocation"></i>
              {{ item.location }}
            </span>
          </div>
          <h5 class="timeline-title">{{ item.title }}</h5>
          <p class="timeline-host">
            <i class="fa-solid fa-building-columns iconinstitution"></i>
            {%- if item.host_url -%}
              <a href="{{ item.host_url }}" target="_blank" rel="noopener noreferrer">{{ item.host }}</a>
            {%- else -%}
              {{ item.host }}
            {%- endif %}
          </p>
          {% if item.description %}
            <p class="timeline-description">{{ item.description }}</p>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
</div>
